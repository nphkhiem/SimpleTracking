<?xml version="1.0" encoding="utf-8"?>
<!--
  Landscape: the sheet becomes a side rail so the map keeps the majority of the screen. In portrait
  the sheet takes the bottom strip; laid out the same way in landscape it took roughly 62% of the
  height and left a letterbox of map.

  Every id matches the portrait layout exactly, so RecordFragment binds against one set of views and
  needs no orientation-specific code.
-->
<androidx.coordinatorlayout.widget.CoordinatorLayout xmlns:android="http://schemas.android.com/apk/res/android"
    xmlns:app="http://schemas.android.com/apk/res-auto"
    xmlns:tools="http://schemas.android.com/tools"
    android:id="@+id/record_root"
    android:layout_width="match_parent"
    android:layout_height="match_parent">

    <FrameLayout
        android:id="@+id/record_map_container"
        android:layout_width="match_parent"
        android:layout_height="match_parent" />

    <!-- Sits above the map and hides itself once the map reports it has finished loading. -->
    <androidx.compose.ui.platform.ComposeView
        android:id="@+id/record_route_fallback"
        android:layout_width="match_parent"
        android:layout_height="match_parent" />

    <ImageButton
        android:id="@+id/record_back_button"
        android:layout_width="48dp"
        android:layout_height="48dp"
        android:layout_margin="@dimen/record_close_button_margin"
        android:background="@drawable/bg_back_button_floating"
        android:contentDescription="@string/record_back_content_description"
        android:padding="8dp"
        android:src="@drawable/ic_close" />

    <!--
      GPS status floated over the map, matching portrait. Anchored top|start here because the rail
      occupies the end edge, so top|end would sit underneath it, and clear of the back button.
    -->
    <TextView
        android:id="@+id/record_signal_tag"
        android:layout_width="wrap_content"
        android:layout_height="wrap_content"
        android:layout_gravity="top|start"
        android:layout_marginTop="@dimen/record_close_button_margin"
        android:layout_marginStart="76dp"
        android:minHeight="48dp"
        android:gravity="center_vertical"
        android:background="@drawable/bg_record_signal_chip"
        android:drawableStart="@drawable/ic_signal_bars"
        android:drawablePadding="7dp"
        android:letterSpacing="0.05"
        android:paddingHorizontal="12dp"
        android:paddingVertical="8dp"
        android:textAllCaps="true"
        android:textAppearance="@style/TextAppearance.ChayNgayDi.LabelMedium"
        android:textStyle="bold"
        tools:text="@string/record_signal_good" />

    <LinearLayout
        android:id="@+id/record_bottom_sheet"
        android:layout_width="320dp"
        android:layout_height="match_parent"
        android:layout_gravity="end"
        android:background="@drawable/bg_record_bottom_sheet"
        android:orientation="vertical"
        android:paddingTop="12dp"
        android:paddingBottom="28dp"
        android:gravity="center_vertical">

        <TextView
            android:id="@+id/record_paused_tag"
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:layout_marginBottom="12dp"
            android:gravity="center"
            android:background="@drawable/bg_record_paused_banner"
            android:letterSpacing="0.05"
            android:paddingHorizontal="16dp"
            android:paddingVertical="10dp"
            android:text="@string/record_paused_tag"
            android:textAllCaps="true"
            android:textColor="?attr/colorOnError"
            android:textAppearance="@style/TextAppearance.ChayNgayDi.LabelMedium"
            android:textStyle="bold"
            android:visibility="gone"
            tools:visibility="visible" />


        <LinearLayout
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:layout_marginBottom="24dp"
            android:baselineAligned="false"
            android:orientation="vertical">

            <!--
                 Same hierarchy as portrait, stacked instead of side by side, but NOT the same
                 sizes. The rail is height-bound: portrait's 57sp hero and 22sp trio pushed the Stop
                 and Pause controls off the bottom edge, which is a functional failure on the one
                 screen where reaching Stop matters. Landscape therefore holds a smaller step, and
                 the controls staying on screen outranks matching portrait.
            -->
            <LinearLayout
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:layout_marginBottom="14dp"
                android:gravity="center"
                android:orientation="vertical">

                <TextView
                    android:id="@+id/record_distance_value"
                    android:layout_width="match_parent"
                    android:layout_height="wrap_content"
                    android:gravity="center"
                    android:maxLines="1"
                    android:autoSizeTextType="uniform"
                    android:autoSizeMinTextSize="22sp"
                    android:autoSizeMaxTextSize="36sp"
                    android:textColor="?attr/colorOnSurface"
                    android:textAppearance="@style/TextAppearance.ChayNgayDi.DisplaySmall"
                    android:textStyle="bold"
                    tools:text="5,42" />

                <TextView
                    android:layout_width="wrap_content"
                    android:layout_height="wrap_content"
                    android:text="@string/record_hero_unit"
                    android:textColor="?attr/colorOnSurfaceVariant"
                    android:textAppearance="@style/TextAppearance.ChayNgayDi.LabelSmall"
                    android:textStyle="bold" />

            </LinearLayout>

            <LinearLayout
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:layout_marginBottom="12dp"
                android:gravity="center"
                android:orientation="vertical">

                <TextView
                    android:id="@+id/record_duration_value"
                    android:layout_width="wrap_content"
                    android:layout_height="wrap_content"
                    android:textColor="?attr/colorOnSurface"
                    android:textAppearance="@style/TextAppearance.ChayNgayDi.TitleMedium"
                    android:textStyle="bold"
                    tools:text="32:18" />

                <TextView
                    android:layout_width="wrap_content"
                    android:layout_height="wrap_content"
                    android:text="@string/record_duration_unit"
                    android:textColor="?attr/colorOnSurfaceVariant"
                    android:textAppearance="@style/TextAppearance.ChayNgayDi.LabelSmall"
                    android:textStyle="bold" />

            </LinearLayout>

            <LinearLayout
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:layout_marginBottom="12dp"
                android:gravity="center"
                android:orientation="vertical">

                <TextView
                    android:id="@+id/record_current_speed_value"
                    android:layout_width="wrap_content"
                    android:layout_height="wrap_content"
                    android:textColor="?attr/colorPrimary"
                    android:textAppearance="@style/TextAppearance.ChayNgayDi.TitleMedium"
                    android:textStyle="bold"
                    tools:text="5:24" />

                <TextView
                    android:layout_width="wrap_content"
                    android:layout_height="wrap_content"
                    android:text="@string/record_current_pace_unit"
                    android:textColor="?attr/colorOnSurfaceVariant"
                    android:textAppearance="@style/TextAppearance.ChayNgayDi.LabelSmall"
                    android:textStyle="bold" />

            </LinearLayout>

            <LinearLayout
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:layout_marginBottom="12dp"
                android:gravity="center"
                android:orientation="vertical">

                <TextView
                    android:id="@+id/record_average_pace_value"
                    android:layout_width="wrap_content"
                    android:layout_height="wrap_content"
                    android:textColor="?attr/colorOnSurface"
                    android:textAppearance="@style/TextAppearance.ChayNgayDi.TitleMedium"
                    android:textStyle="bold"
                    tools:text="5:31" />

                <TextView
                    android:layout_width="wrap_content"
                    android:layout_height="wrap_content"
                    android:text="@string/record_average_pace_unit"
                    android:textColor="?attr/colorOnSurfaceVariant"
                    android:textAppearance="@style/TextAppearance.ChayNgayDi.LabelSmall"
                    android:textStyle="bold" />

            </LinearLayout>


        </LinearLayout>

        <LinearLayout
            android:layout_width="wrap_content"
            android:layout_height="wrap_content"
            android:layout_gravity="center_horizontal"
            android:gravity="center_vertical"
            android:orientation="horizontal">

            <ImageButton
                android:id="@+id/record_stop_button"
                android:layout_width="52dp"
                android:layout_height="52dp"
                android:layout_marginEnd="20dp"
                android:background="@drawable/bg_record_stop_button"
                android:contentDescription="@string/record_stop_content_description"
                android:padding="14dp"
                android:src="@drawable/ic_stop" />

            <ImageButton
                android:id="@+id/record_pause_resume_button"
                android:layout_width="68dp"
                android:layout_height="68dp"
                android:background="@drawable/bg_record_main_button"
                android:contentDescription="@string/record_pause_content_description"
                android:padding="20dp"
                android:src="@drawable/ic_pause" />

        </LinearLayout>

    </LinearLayout>

</androidx.coordinatorlayout.widget.CoordinatorLayout>
