<?xml version="1.0" encoding="utf-8"?>
<!--
  Landscape: the sheet becomes a side rail so the map keeps the majority of the screen. In portrait
  the sheet takes the bottom strip; laid out the same way in landscape it took roughly 62% of the
  height and left a letterbox of map.

  Every id matches the portrait layout exactly, so RecordFragment binds against one set of views and
  needs no orientation-specific code.
-->
<androidx.coordinatorlayout.widget.CoordinatorLayout xmlns:android="http://schemas.android.com/apk/res/android"
    xmlns:app="http://schemas.android.com/apk/res-auto"
    xmlns:tools="http://schemas.android.com/tools"
    android:id="@+id/record_root"
    android:layout_width="match_parent"
    android:layout_height="match_parent">

    <FrameLayout
        android:id="@+id/record_map_container"
        android:layout_width="match_parent"
        android:layout_height="match_parent" />

    <!-- Sits above the map and hides itself once the map reports it has finished loading. -->
    <androidx.compose.ui.platform.ComposeView
        android:id="@+id/record_route_fallback"
        android:layout_width="match_parent"
        android:layout_height="match_parent" />

    <ImageButton
        android:id="@+id/record_back_button"
        android:layout_width="48dp"
        android:layout_height="48dp"
        android:layout_margin="@dimen/record_close_button_margin"
        android:background="@drawable/bg_back_button_floating"
        android:contentDescription="@string/record_back_content_description"
        android:padding="8dp"
        android:src="@drawable/ic_close" />

    <LinearLayout
        android:id="@+id/record_bottom_sheet"
        android:layout_width="320dp"
        android:layout_height="match_parent"
        android:layout_gravity="end"
        android:background="@drawable/bg_record_bottom_sheet"
        android:orientation="vertical"
        android:paddingTop="12dp"
        android:paddingBottom="28dp"
        android:gravity="center_vertical">

        <TextView
            android:id="@+id/record_paused_tag"
            android:layout_width="wrap_content"
            android:layout_height="wrap_content"
            android:layout_gravity="center_horizontal"
            android:layout_marginBottom="8dp"
            android:letterSpacing="0.05"
            android:text="@string/record_paused_tag"
            android:textAllCaps="true"
            android:textColor="?attr/colorTertiary"
            android:textAppearance="@style/TextAppearance.ChayNgayDi.LabelMedium"
            android:textStyle="bold"
            android:visibility="gone"
            tools:visibility="visible" />

        <!--
          Reserved space, never gone: the status line occupies a row whether or not it has anything
          to say, so the metrics below never jump when the signal changes mid-run.
        -->
        <TextView
            android:id="@+id/record_signal_tag"
            android:layout_width="wrap_content"
            android:layout_height="wrap_content"
            android:layout_gravity="center_horizontal"
            android:layout_marginBottom="8dp"
            android:letterSpacing="0.05"
            android:textAllCaps="true"
            android:textAppearance="@style/TextAppearance.ChayNgayDi.LabelMedium"
            android:textStyle="bold"
            android:visibility="invisible"
            tools:text="@string/record_signal_weak"
            tools:visibility="visible" />

        <LinearLayout
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:layout_marginBottom="24dp"
            android:baselineAligned="false"
            android:orientation="vertical">

            <LinearLayout
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:layout_marginBottom="16dp"
                android:gravity="center"
                android:orientation="vertical">

                <TextView
                    android:id="@+id/record_distance_value"
                    android:layout_width="wrap_content"
                    android:layout_height="wrap_content"
                    android:textColor="?attr/colorOnSurface"
                    android:textAppearance="@style/TextAppearance.ChayNgayDi.TitleMedium"
                    android:textStyle="bold"
                    tools:text="5.42" />

                <TextView
                    android:layout_width="wrap_content"
                    android:layout_height="wrap_content"
                    android:text="@string/record_distance_unit"
                    android:textColor="?attr/colorOnSurfaceVariant"
                    android:textAppearance="@style/TextAppearance.ChayNgayDi.LabelSmall"
                    android:textStyle="bold" />

            </LinearLayout>

            <LinearLayout
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:layout_marginBottom="16dp"
                android:gravity="center"
                android:orientation="vertical">

                <TextView
                    android:id="@+id/record_current_speed_value"
                    android:layout_width="wrap_content"
                    android:layout_height="wrap_content"
                    android:textColor="?attr/colorPrimary"
                    android:textAppearance="@style/TextAppearance.ChayNgayDi.TitleLarge"
                    android:textStyle="bold"
                    tools:text="12.4" />

                <TextView
                    android:layout_width="wrap_content"
                    android:layout_height="wrap_content"
                    android:text="@string/record_current_speed_unit"
                    android:textColor="?attr/colorOnSurfaceVariant"
                    android:textAppearance="@style/TextAppearance.ChayNgayDi.LabelSmall"
                    android:textStyle="bold" />

            </LinearLayout>

            <LinearLayout
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:layout_marginBottom="16dp"
                android:gravity="center"
                android:orientation="vertical">

                <TextView
                    android:id="@+id/record_duration_value"
                    android:layout_width="wrap_content"
                    android:layout_height="wrap_content"
                    android:textColor="?attr/colorOnSurface"
                    android:textAppearance="@style/TextAppearance.ChayNgayDi.TitleMedium"
                    android:textStyle="bold"
                    tools:text="32:18" />

                <TextView
                    android:layout_width="wrap_content"
                    android:layout_height="wrap_content"
                    android:text="@string/record_duration_unit"
                    android:textColor="?attr/colorOnSurfaceVariant"
                    android:textAppearance="@style/TextAppearance.ChayNgayDi.LabelSmall"
                    android:textStyle="bold" />

            </LinearLayout>

        </LinearLayout>

        <LinearLayout
            android:layout_width="wrap_content"
            android:layout_height="wrap_content"
            android:layout_gravity="center_horizontal"
            android:gravity="center_vertical"
            android:orientation="horizontal">

            <ImageButton
                android:id="@+id/record_stop_button"
                android:layout_width="52dp"
                android:layout_height="52dp"
                android:layout_marginEnd="20dp"
                android:background="@drawable/bg_record_stop_button"
                android:contentDescription="@string/record_stop_content_description"
                android:padding="14dp"
                android:src="@drawable/ic_stop" />

            <ImageButton
                android:id="@+id/record_pause_resume_button"
                android:layout_width="68dp"
                android:layout_height="68dp"
                android:background="@drawable/bg_record_main_button"
                android:contentDescription="@string/record_pause_content_description"
                android:padding="20dp"
                android:src="@drawable/ic_pause" />

        </LinearLayout>

    </LinearLayout>

</androidx.coordinatorlayout.widget.CoordinatorLayout>
