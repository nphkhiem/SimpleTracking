<?xml version="1.0" encoding="utf-8"?>
<!--
  Solid accent-filled circle behind the Record screen's Pause/Resume control, per the reviewed
  mockup. Wrapped in a ripple so the press is acknowledged: this is the control a runner taps
  without looking, and a button that gives no feedback invites a second tap.
-->
<ripple xmlns:android="http://schemas.android.com/apk/res/android"
    android:color="?attr/colorOnPrimary">
    <item android:id="@android:id/mask">
        <shape android:shape="oval">
            <solid android:color="?attr/colorOnPrimary" />
        </shape>
    </item>
    <item>
        <shape android:shape="oval">
            <solid android:color="?attr/colorPrimary" />
        </shape>
    </item>
</ripple>
