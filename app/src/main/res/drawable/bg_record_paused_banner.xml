<?xml version="1.0" encoding="utf-8"?>
<!--
  Full-bleed banner behind the paused status.

  Square rather than rounded because it spans the sheet edge to edge: a radius on a full-width bar
  reads as a pill that failed to fit rather than as a band. It was a centred pill first, and the
  owner asked for the full width, which is the stronger signal for the state most easily missed.
-->
<shape xmlns:android="http://schemas.android.com/apk/res/android"
    android:shape="rectangle">
    <solid android:color="?attr/colorError" />
</shape>
