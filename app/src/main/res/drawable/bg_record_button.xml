<?xml version="1.0" encoding="utf-8"?>
<!--
  Pill-shaped, surface-tinted background for HistoryFragment's floating Record button - white in
  light theme, near-black in dark theme (see values(-night)/colors.xml), per the reviewed mockup.
-->
<shape xmlns:android="http://schemas.android.com/apk/res/android"
    android:shape="rectangle">
    <solid android:color="@color/history_surface" />
    <stroke
        android:width="1dp"
        android:color="@color/history_border" />
    <corners android:radius="999dp" />
</shape>
