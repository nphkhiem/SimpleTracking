<!--
  The themed-icon layer. Android replaces every colour with a single system tint, so this is the
  same letterforms with the ground removed. A wordmark survives that by construction; the route
  line the previous round tried did not.

  Keep these paths identical to ic_launcher_foreground.xml, which carries the geometry reasoning.
  If the two drift, the themed icon stops being the same mark.
-->
<vector xmlns:android="http://schemas.android.com/apk/res/android"
    android:width="108dp"
    android:height="108dp"
    android:viewportWidth="108"
    android:viewportHeight="108">
    <!-- R: stem and bowl -->
    <path
        android:pathData="M33.75,63 L33.75,47.25 L39.75,47.25 A3,3 0 0 1 42.75,50.25 L42.75,52.125 A3,3 0 0 1 39.75,55.125 L33.75,55.125"
        android:strokeColor="#FF000000"
        android:strokeWidth="4.5"
        android:strokeLineCap="butt"
        android:strokeLineJoin="miter" />
    <!-- R: the leg, filled so its terminal is flat on the baseline -->
    <path
        android:pathData="M32.65,55.5 L38.57,55.5 L45,63 L39.08,63 Z"
        android:fillColor="#FF000000" />
    <!-- U -->
    <path
        android:pathData="M49.5,45 L49.5,57.75 A3,3 0 0 0 52.5,60.75 L55.5,60.75 A3,3 0 0 0 58.5,57.75 L58.5,45"
        android:strokeColor="#FF000000"
        android:strokeWidth="4.5"
        android:strokeLineCap="butt"
        android:strokeLineJoin="miter" />
    <!-- N: two square stems and a separate diagonal -->
    <path
        android:pathData="M65.25,63 L65.25,45 M74.25,45 L74.25,63 M65.25,46.5 L74.25,61.5"
        android:strokeColor="#FF000000"
        android:strokeWidth="4.5"
        android:strokeLineCap="butt"
        android:strokeLineJoin="miter" />
</vector>
