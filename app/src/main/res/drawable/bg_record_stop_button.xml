<?xml version="1.0" encoding="utf-8"?>
<!-- Surface-tinted circle behind the Record screen's Stop control, per the reviewed mockup.   Same control highlight as the main button: a press should darken the surface, not repaint it.
-->
<ripple xmlns:android="http://schemas.android.com/apk/res/android"
    android:color="?android:attr/colorControlHighlight">
    <item android:id="@android:id/mask">
        <shape android:shape="oval">
            <solid android:color="?attr/colorPrimary" />
        </shape>
    </item>
    <item>
        <shape android:shape="oval">
            <solid android:color="?attr/colorSurface" />
            <stroke
                android:width="1dp"
                android:color="?attr/colorOutlineVariant" />
        </shape>
    </item>
</ripple>
