<?xml version="1.0" encoding="utf-8"?>
<!--
  Small solid dot used as the Record button's record indicator. Drawn white and tinted by the
  button to its on-colour: it sits on a colorPrimary fill, so a clay dot would be invisible in
  light theme and near-invisible in dark.
-->
<shape xmlns:android="http://schemas.android.com/apk/res/android"
    android:shape="oval">
    <solid android:color="#FFFFFFFF" />
    <size
        android:width="10dp"
        android:height="10dp" />
</shape>
