<?xml version="1.0" encoding="utf-8"?>
<!--
  Bricolage Grotesque at a display optical size, for the oversized numerals.

  The bundled file is a variable font whose default instance is "96pt ExtraBold". Every weight and
  optical size must therefore be stated: without them the whole app renders extra-bold at an optical
  size drawn for billboard sizes.
-->
<font-family xmlns:android="http://schemas.android.com/apk/res/android">
    <font
        android:font="@font/bricolage_grotesque"
        android:fontStyle="normal"
        android:fontWeight="400"
        android:fontVariationSettings="'wght' 400, 'opsz' 40" />
    <font
        android:font="@font/bricolage_grotesque"
        android:fontStyle="normal"
        android:fontWeight="500"
        android:fontVariationSettings="'wght' 500, 'opsz' 40" />
    <font
        android:font="@font/bricolage_grotesque"
        android:fontStyle="normal"
        android:fontWeight="700"
        android:fontVariationSettings="'wght' 700, 'opsz' 40" />
</font-family>
