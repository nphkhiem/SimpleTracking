<?xml version="1.0" encoding="utf-8"?>
<!--
  Bricolage Grotesque at a text optical size, for everything below the headline tiers.

  Optical size is not cosmetic here: the 96pt default instance is drawn with tight spacing and fine
  details that fall apart at 11sp, which is where the app's smallest unit labels live.
-->
<font-family xmlns:android="http://schemas.android.com/apk/res/android">
    <font
        android:font="@font/bricolage_grotesque"
        android:fontStyle="normal"
        android:fontWeight="400"
        android:fontVariationSettings="'wght' 400, 'opsz' 14" />
    <font
        android:font="@font/bricolage_grotesque"
        android:fontStyle="normal"
        android:fontWeight="500"
        android:fontVariationSettings="'wght' 500, 'opsz' 14" />
    <font
        android:font="@font/bricolage_grotesque"
        android:fontStyle="normal"
        android:fontWeight="700"
        android:fontVariationSettings="'wght' 700, 'opsz' 14" />
</font-family>
