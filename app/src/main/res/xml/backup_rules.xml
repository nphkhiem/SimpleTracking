<?xml version="1.0" encoding="utf-8"?>
<!--
  The API 29-30 counterpart to data_extraction_rules.xml, which only applies from API 31.

  With android:allowBackup="false" this is not consulted at all, so it is deliberately belt and
  braces: if backup is ever turned back on, the exclusions are already in place rather than the
  user's movement history silently becoming eligible for upload in the same commit.
-->
<full-backup-content>
    <exclude domain="root" path="." />
    <exclude domain="database" path="." />
    <exclude domain="sharedpref" path="." />
    <exclude domain="file" path="." />
    <exclude domain="external" path="." />
</full-backup-content>
