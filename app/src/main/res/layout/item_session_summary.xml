<?xml version="1.0" encoding="utf-8"?>
<androidx.constraintlayout.widget.ConstraintLayout xmlns:android="http://schemas.android.com/apk/res/android"
    xmlns:app="http://schemas.android.com/apk/res-auto"
    xmlns:tools="http://schemas.android.com/tools"
    android:layout_width="match_parent"
    android:layout_height="wrap_content"
    android:paddingStart="16dp"
    android:paddingEnd="16dp">

    <ImageView
        android:id="@+id/history_item_thumbnail"
        android:layout_width="56dp"
        android:layout_height="56dp"
        android:layout_marginTop="14dp"
        android:layout_marginBottom="14dp"
        android:background="@drawable/bg_thumbnail_placeholder"
        android:clipToOutline="true"
        android:contentDescription="@string/history_item_thumbnail_content_description"
        android:scaleType="centerCrop"
        app:layout_constraintBottom_toBottomOf="parent"
        app:layout_constraintStart_toStartOf="parent"
        app:layout_constraintTop_toTopOf="parent"
        tools:src="@drawable/bg_thumbnail_placeholder" />

    <TextView
        android:id="@+id/history_item_distance"
        android:layout_width="0dp"
        android:layout_height="wrap_content"
        android:layout_marginStart="12dp"
        android:layout_marginTop="14dp"
        android:textColor="@color/history_ink"
        android:textSize="18sp"
        android:textStyle="bold"
        app:layout_constraintEnd_toEndOf="parent"
        app:layout_constraintStart_toEndOf="@id/history_item_thumbnail"
        app:layout_constraintTop_toTopOf="parent"
        tools:text="5.42 km" />

    <LinearLayout
        android:id="@+id/history_item_sub_row"
        android:layout_width="0dp"
        android:layout_height="wrap_content"
        android:layout_marginTop="4dp"
        android:layout_marginBottom="14dp"
        android:orientation="horizontal"
        app:layout_constraintBottom_toBottomOf="parent"
        app:layout_constraintEnd_toEndOf="@id/history_item_distance"
        app:layout_constraintStart_toStartOf="@id/history_item_distance"
        app:layout_constraintTop_toBottomOf="@id/history_item_distance">

        <TextView
            android:id="@+id/history_item_duration"
            android:layout_width="wrap_content"
            android:layout_height="wrap_content"
            android:textColor="@color/history_ink_soft"
            android:textSize="13sp"
            tools:text="32:18" />

        <TextView
            android:layout_width="wrap_content"
            android:layout_height="wrap_content"
            android:text="@string/history_item_stats_separator"
            android:textColor="@color/history_ink_soft"
            android:textSize="13sp" />

        <TextView
            android:id="@+id/history_item_average_speed"
            android:layout_width="wrap_content"
            android:layout_height="wrap_content"
            android:textColor="@color/history_ink_soft"
            android:textSize="13sp"
            tools:text="10.1 km/h avg" />

    </LinearLayout>

    <View
        android:id="@+id/history_item_divider"
        android:layout_width="0dp"
        android:layout_height="1dp"
        android:background="@color/history_border"
        app:layout_constraintBottom_toBottomOf="parent"
        app:layout_constraintEnd_toEndOf="parent"
        app:layout_constraintStart_toStartOf="parent" />

</androidx.constraintlayout.widget.ConstraintLayout>
