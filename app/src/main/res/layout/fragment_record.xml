<?xml version="1.0" encoding="utf-8"?>
<androidx.coordinatorlayout.widget.CoordinatorLayout xmlns:android="http://schemas.android.com/apk/res/android"
    xmlns:app="http://schemas.android.com/apk/res-auto"
    xmlns:tools="http://schemas.android.com/tools"
    android:id="@+id/record_root"
    android:layout_width="match_parent"
    android:layout_height="match_parent">

    <FrameLayout
        android:id="@+id/record_map_container"
        android:layout_width="match_parent"
        android:layout_height="match_parent" />

    <!-- Sits above the map and hides itself once the map reports it has finished loading. -->
    <androidx.compose.ui.platform.ComposeView
        android:id="@+id/record_route_fallback"
        android:layout_width="match_parent"
        android:layout_height="match_parent" />

    <ImageButton
        android:id="@+id/record_back_button"
        android:layout_width="36dp"
        android:layout_height="36dp"
        android:layout_margin="16dp"
        android:background="@drawable/bg_back_button_floating"
        android:contentDescription="@string/record_back_content_description"
        android:padding="8dp"
        android:src="@drawable/ic_close" />

    <LinearLayout
        android:id="@+id/record_bottom_sheet"
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:background="@drawable/bg_record_bottom_sheet"
        android:orientation="vertical"
        android:paddingTop="12dp"
        android:paddingBottom="28dp"
        app:layout_behavior="@string/bottom_sheet_behavior">

        <View
            android:layout_width="40dp"
            android:layout_height="4dp"
            android:layout_gravity="center_horizontal"
            android:layout_marginBottom="12dp"
            android:background="@drawable/bg_sheet_handle" />

        <TextView
            android:id="@+id/record_paused_tag"
            android:layout_width="wrap_content"
            android:layout_height="wrap_content"
            android:layout_gravity="center_horizontal"
            android:layout_marginBottom="8dp"
            android:letterSpacing="0.05"
            android:text="@string/record_paused_tag"
            android:textAllCaps="true"
            android:textColor="@color/record_paused_ink"
            android:textSize="12sp"
            android:textStyle="bold"
            android:visibility="gone"
            tools:visibility="visible" />

        <!--
          Reserved space, never gone: the status line occupies a row whether or not it has anything
          to say, so the metrics below never jump when the signal changes mid-run.
        -->
        <TextView
            android:id="@+id/record_signal_tag"
            android:layout_width="wrap_content"
            android:layout_height="wrap_content"
            android:layout_gravity="center_horizontal"
            android:layout_marginBottom="8dp"
            android:letterSpacing="0.05"
            android:textAllCaps="true"
            android:textSize="12sp"
            android:textStyle="bold"
            android:visibility="invisible"
            tools:text="@string/record_signal_weak"
            tools:visibility="visible" />

        <LinearLayout
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:layout_marginBottom="24dp"
            android:baselineAligned="false"
            android:orientation="horizontal">

            <LinearLayout
                android:layout_width="0dp"
                android:layout_height="wrap_content"
                android:layout_weight="1"
                android:gravity="center"
                android:orientation="vertical">

                <TextView
                    android:id="@+id/record_distance_value"
                    android:layout_width="wrap_content"
                    android:layout_height="wrap_content"
                    android:textColor="@color/history_ink"
                    android:textSize="18sp"
                    android:textStyle="bold"
                    tools:text="5.42" />

                <TextView
                    android:layout_width="wrap_content"
                    android:layout_height="wrap_content"
                    android:text="@string/record_distance_unit"
                    android:textColor="@color/history_ink_soft"
                    android:textSize="11sp"
                    android:textStyle="bold" />

            </LinearLayout>

            <LinearLayout
                android:layout_width="0dp"
                android:layout_height="wrap_content"
                android:layout_weight="1"
                android:gravity="center"
                android:orientation="vertical">

                <TextView
                    android:id="@+id/record_current_speed_value"
                    android:layout_width="wrap_content"
                    android:layout_height="wrap_content"
                    android:textColor="@color/history_accent"
                    android:textSize="22sp"
                    android:textStyle="bold"
                    tools:text="12.4" />

                <TextView
                    android:layout_width="wrap_content"
                    android:layout_height="wrap_content"
                    android:text="@string/record_current_speed_unit"
                    android:textColor="@color/history_ink_soft"
                    android:textSize="11sp"
                    android:textStyle="bold" />

            </LinearLayout>

            <LinearLayout
                android:layout_width="0dp"
                android:layout_height="wrap_content"
                android:layout_weight="1"
                android:gravity="center"
                android:orientation="vertical">

                <TextView
                    android:id="@+id/record_duration_value"
                    android:layout_width="wrap_content"
                    android:layout_height="wrap_content"
                    android:textColor="@color/history_ink"
                    android:textSize="18sp"
                    android:textStyle="bold"
                    tools:text="32:18" />

                <TextView
                    android:layout_width="wrap_content"
                    android:layout_height="wrap_content"
                    android:text="@string/record_duration_unit"
                    android:textColor="@color/history_ink_soft"
                    android:textSize="11sp"
                    android:textStyle="bold" />

            </LinearLayout>

        </LinearLayout>

        <LinearLayout
            android:layout_width="wrap_content"
            android:layout_height="wrap_content"
            android:layout_gravity="center_horizontal"
            android:gravity="center_vertical"
            android:orientation="horizontal">

            <ImageButton
                android:id="@+id/record_stop_button"
                android:layout_width="52dp"
                android:layout_height="52dp"
                android:layout_marginEnd="20dp"
                android:background="@drawable/bg_record_stop_button"
                android:contentDescription="@string/record_stop_content_description"
                android:padding="14dp"
                android:src="@drawable/ic_stop" />

            <ImageButton
                android:id="@+id/record_pause_resume_button"
                android:layout_width="68dp"
                android:layout_height="68dp"
                android:background="@drawable/bg_record_main_button"
                android:contentDescription="@string/record_pause_content_description"
                android:padding="20dp"
                android:src="@drawable/ic_pause" />

        </LinearLayout>

    </LinearLayout>

</androidx.coordinatorlayout.widget.CoordinatorLayout>
